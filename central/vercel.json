{
  "rewrites": [
    {
      "source": "/r/:slug",
      "destination": "/api/r?s=:slug"
    },
    {
      "source": "/compartilhar",
      "destination": "/api/compartilhar"
    }
  ],
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(sw.js|assistente/sw.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(app.js|styles.css|cena3d.js|nucleo.js|regiao.js|assistente/assistente.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "cleanUrls": true
}