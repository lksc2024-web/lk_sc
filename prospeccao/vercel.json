{
  "functions": {
    "api/*.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/vendas.js",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://central-lk.vercel.app"
        }
      ]
    }
  ]
}
